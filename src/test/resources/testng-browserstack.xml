<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="PRODIGY_ST_04 BrowserStack Cloud Selenium Grid Suite" verbose="1" parallel="tests" thread-count="4">

    <!-- 1. Google Chrome on Windows 11 -->
    <test name="Chrome on Windows 11">
        <parameter name="browser" value="chrome"/>
        <parameter name="browser_version" value="latest"/>
        <parameter name="os" value="Windows"/>
        <parameter name="os_version" value="11"/>
        <parameter name="is_browserstack" value="true"/>
        <classes>
            <class name="com.prodigy.task4.tests.CrossBrowserLoginTest"/>
        </classes>
    </test>

    <!-- 2. Mozilla Firefox on Windows 11 -->
    <test name="Firefox on Windows 11">
        <parameter name="browser" value="firefox"/>
        <parameter name="browser_version" value="latest"/>
        <parameter name="os" value="Windows"/>
        <parameter name="os_version" value="11"/>
        <parameter name="is_browserstack" value="true"/>
        <classes>
            <class name="com.prodigy.task4.tests.CrossBrowserLoginTest"/>
        </classes>
    </test>

    <!-- 3. Apple Safari on macOS Sonoma -->
    <test name="Safari on macOS Sonoma">
        <parameter name="browser" value="safari"/>
        <parameter name="browser_version" value="latest"/>
        <parameter name="os" value="OS X"/>
        <parameter name="os_version" value="Sonoma"/>
        <parameter name="is_browserstack" value="true"/>
        <classes>
            <class name="com.prodigy.task4.tests.CrossBrowserLoginTest"/>
        </classes>
    </test>

    <!-- 4. Microsoft Edge on Windows 11 -->
    <test name="Microsoft Edge on Windows 11">
        <parameter name="browser" value="edge"/>
        <parameter name="browser_version" value="latest"/>
        <parameter name="os" value="Windows"/>
        <parameter name="os_version" value="11"/>
        <parameter name="is_browserstack" value="true"/>
        <classes>
            <class name="com.prodigy.task4.tests.CrossBrowserLoginTest"/>
        </classes>
    </test>

    <!-- 5. Mobile Device: Safari on iPhone 15 -->
    <test name="Mobile Safari on iPhone 15">
        <parameter name="device" value="iPhone 15"/>
        <parameter name="os_version" value="17"/>
        <parameter name="is_browserstack" value="true"/>
        <classes>
            <class name="com.prodigy.task4.tests.CrossBrowserLoginTest"/>
        </classes>
    </test>

</suite>
