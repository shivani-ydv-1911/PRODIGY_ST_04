<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross Browser Local Execution Suite" verbose="1" parallel="tests" thread-count="2">

    <!-- Chrome Browser Test -->
    <test name="Chrome Test Execution">
        <parameter name="browser" value="chrome"/>
        <parameter name="is_browserstack" value="false"/>
        <classes>
            <class name="com.prodigy.task4.tests.CrossBrowserLoginTest"/>
        </classes>
    </test>

    <!-- Edge Browser Test -->
    <test name="Edge Test Execution">
        <parameter name="browser" value="edge"/>
        <parameter name="is_browserstack" value="false"/>
        <classes>
            <class name="com.prodigy.task4.tests.CrossBrowserLoginTest"/>
        </classes>
    </test>

</suite>
